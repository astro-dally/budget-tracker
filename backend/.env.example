# Copy to backend/.env and adjust. Every value has a working default.

# Database. SQLite needs no setup; for PostgreSQL install the extra
# (pip install -e ".[postgres]") and use e.g.
# DATABASE_URL=postgresql+psycopg://budget:budget@localhost:5432/budget
DATABASE_URL=sqlite:///./budget_tracker.db

# Comma-separated origins allowed to call the API (the Next.js app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AUTO_MIGRATE=true          # run Alembic migrations on start-up
SEED_DEMO_DATA=true        # create demo accounts (and their data) in an empty database
SCHEDULER_ENABLED=true     # generate recurring transactions in the background
RECURRING_JOB_INTERVAL_MINUTES=60

ALERT_THRESHOLDS=80,100                          # one alert rule per percentage
NOTIFICATION_CHANNELS=console,in_app,email,sms   # any of: console, in_app, email, sms
CATEGORIZATION_ORDER=keyword,merchant,user_defined,default

# E-mail: leave SMTP_HOST empty to log e-mails instead of sending them
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=alerts@budget-tracker.local   # alerts go to each user's own e-mail

# SMS (stub): set a number to see formatted SMS messages in the log
ALERT_SMS_TO=

LOG_LEVEL=INFO

# Sessions. ALWAYS set a long random secret in production, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-in-production-0123456789abcdef
TOKEN_LIFETIME_HOURS=24
